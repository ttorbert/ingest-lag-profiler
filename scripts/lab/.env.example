# Copy to scripts/lab/.env. `make lab-up` does this for you and fills in random
# passwords and a random Kibana encryption key the first time.

STACK_VERSION=9.5.6
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
KIBANA_ENCRYPTION_KEY=changeme-at-least-32-characters-long

ES_PORT=9200
KIBANA_PORT=5601

# Sized for a Rancher Desktop VM with 8 GB.
ES_HEAP=2g
ES_MEM_LIMIT=4g
KIBANA_MEM_LIMIT=3g
KIBANA_NODE_MEMORY_MB=2048
