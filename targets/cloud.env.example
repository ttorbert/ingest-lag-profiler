# Copy to targets/<name>.env (git-ignored) and fill in.
# Elastic Cloud hosted deployment. See docs/setup-guide.md, step 3.
LAGPROF_TARGET=cloud

# Both endpoints are on the deployment page ("Copy endpoint").
ES_URL=https://<deployment>.es.<region>.<provider>.elastic-cloud.com
KIBANA_URL=https://<deployment>.kb.<region>.<provider>.elastic-cloud.com

# Optional instead of the two URLs: the Cloud ID from the deployment's overview page.
# CLOUD_ID=<deployment-name>:<encoded string>

# Elastic Cloud needs an API key (the "Encoded" value). Or refer to an environment
# variable instead of pasting it here: ES_API_KEY=${LAGPROF_ADMIN_KEY}
ES_API_KEY=

# Added in step 7: API key of the workflow's own low-privilege user.
# LAGPROF_WORKFLOW_API_KEY=
