# Copy to targets/<name>.env (git-ignored) and fill in.
LAGPROF_TARGET=self-managed
ES_URL=https://elasticsearch.example.internal:9200
KIBANA_URL=https://kibana.example.internal:5601
# An API key is preferred. Create one with the privileges in the README.
ES_API_KEY=
# Or a user:
# ES_USERNAME=
# ES_PASSWORD=
# CA certificate for a private CA (optional):
CA_CERT=
VERIFY_TLS=true
