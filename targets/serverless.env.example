# Copy to targets/<name>.env (git-ignored) and fill in.
# Elastic Serverless Security project. Both URLs are on the project's
# "Connection details" page. Serverless needs an API key.
LAGPROF_TARGET=serverless
ES_URL=https://<project>.es.<region>.<provider>.elastic.cloud
KIBANA_URL=https://<project>.kb.<region>.<provider>.elastic.cloud
ES_API_KEY=
